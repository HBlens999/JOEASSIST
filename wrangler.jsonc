{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joeassist",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true"
  }
}
